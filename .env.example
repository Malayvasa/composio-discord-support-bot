# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Optional. If set, the bot only auto-responds in these comma-separated channel IDs.
# It still responds to DMs and direct mentions.
SUPPORT_CHANNEL_IDS=

# Composio API key from https://dashboard.composio.dev/settings.
COMPOSIO_API_KEY=

# Model provider key used by the AI SDK OpenAI provider.
OPENAI_API_KEY=

# Optional.
OPENAI_MODEL=gpt-5.2
PORT=5432

# The Composio user ID whose connected accounts represent your support team.
# Customers in Discord should not connect Datadog, Metabase, or internal tools.
SUPPORT_SESSION_USER_ID=support-team

# Bring your own support stack. Remove toolkits you do not use, add internal ones you do.
COMPOSIO_TOOLKITS=github,linear,slack,gmail,datadog,metabase

# Disable if you do not want Composio workbench tools available to the agent.
COMPOSIO_WORKBENCH_ENABLED=false

# How much Discord context to include in each support turn.
DISCORD_CONTEXT_LIMIT=12
MAX_AGENT_STEPS=10


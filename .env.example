# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Optional. If set, the bot only auto-responds in these comma-separated channel IDs.
# It still responds to DMs and direct mentions. Discord forum channel IDs are
# supported; the bot will respond inside matching forum posts.
SUPPORT_CHANNEL_IDS=

# Optional. If SUPPORT_CHANNEL_IDS includes Discord forum channels, restrict
# auto-responses to forum posts created by these Discord user IDs.
SUPPORT_FORUM_AUTHOR_IDS=

# Staff users who can see private diagnostics. Private investigation threads
# are mandatory before Datadog, Metabase, logs, or org/account data are queried.
DEFAULT_STAFF_USER_IDS=
AUTH_STAFF_USER_IDS=
BILLING_STAFF_USER_IDS=
INFRA_STAFF_USER_IDS=
DIAGNOSTICS_STAFF_USER_IDS=

# Optional. Required when support requests originate inside Discord forum posts
# or other threads, because Discord cannot create private threads inside threads.
PRIVATE_DIAGNOSTICS_CHANNEL_ID=
PRIVATE_THREAD_NAME_PREFIX=support-debug

# Composio API key from https://dashboard.composio.dev/settings.
COMPOSIO_API_KEY=

# Model provider key used by the AI SDK OpenAI provider.
OPENAI_API_KEY=

# Optional.
OPENAI_MODEL=gpt-5.2
PORT=5432

# The Composio user ID whose connected accounts represent your support team.
# Customers in Discord should not connect Datadog, Metabase, or internal tools.
SUPPORT_SESSION_USER_ID=support-team

# Bring your own support stack. Remove toolkits you do not use, add internal ones you do.
COMPOSIO_TOOLKITS=github,linear,slack,gmail,datadog,metabase

# Disable if you do not want Composio workbench tools available to the agent.
COMPOSIO_WORKBENCH_ENABLED=false

# How much Discord context to include in each support turn.
DISCORD_CONTEXT_LIMIT=12
MAX_AGENT_STEPS=10

# Attachment handling. Small text-like files are read in private diagnostics.
ATTACHMENT_MAX_FILES=5
ATTACHMENT_MAX_BYTES=1000000
ATTACHMENT_TEXT_MAX_CHARS=12000
